<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # If the requested path is not a file or directory, and doesn't start with /public
    # Then rewrite it to public/ (only for root-level access)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
